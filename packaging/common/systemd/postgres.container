[Unit]
Description=The %N container
PartOf=openchami.target

[Container]
ContainerName=%N
HostName=%N
# Unlike OpenCHAMI components, postgres comes from a non-openchami
# managed registry and has its own versioning scheme, so the version
# of this package cannot be used to select the image.
Image=docker.io/library/postgres:11.5-alpine

[Service]
Restart=always

[Install]
WantedBy=openchami.target
